@model CoffeHub.DTO.UserInfo;

@{
	ViewData["Title"] = "Login Page";
}

<head>
	<link rel="stylesheet" href="~/css/loginpagestyle.css" />
</head>
<body class=" pagebackground">
	<div class="makeitcenter">
		<span class="makeitboldandstyle">Login your Credential</span>
	</div>
	<div class="verticallycenter">
		<div class="loginlayer makeitcenter ">
			<div class="maketheusernamepasswordatcenter">
				<form method="post" class="makegapvertically" asp-controller="Home" asp-action="Menu">
					<div class="makegaphorizontally">
						<label class="label-ch">Username</label>
						<input class=" form-control formcontrol-ch" type="text" placeholder="Enter your username" asp-for="Username" />
					</div>
					<div class="makegaphorizontally">
						<label class="label-ch">Role</label>
						<select class="form-control formcontrol-ch" asp-for="Role">
							<option value="">Select a Role</option>
							<option value="Admin">Admin</option>
							<option value="User">User</option>
						</select>
					</div>
					<div class="makegaphorizontally ">
						<label class="label-ch">Password</label>
						<input type="password" class="form-control formcontrol-ch" asp-for="Password" />
					</div>
					<div>
						<button class="loginbutton" type="submit">Login</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</body>


