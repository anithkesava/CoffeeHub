@using CoffeHub.Helper
@model CoffeHub.Models.UserDetails
@{
	ViewData["Title"] = "Checkout";
}

<title>@ViewData["Title"] - CoffeeHub</title>

<head>
	<link rel="stylesheet" href="~/css/checkoutpagestyle.css" />
</head>
<body class="page-bg">

	@* page top layer *@

	<div class="top-layer">
		<img class="checkout-pg-img" src="~/images/checkout/checkoutpage_img.png" alt="checkout-page-img" />
	</div>

	<div class="checkout-popup-at-middle">
		<div class="checkout-popup">
			<div class="make-the-checkout-popup-scrollable">
				<div class="checkout-address">
					<span>Address: </span>
					<form class="radiobox-address" method="post" id="addressform">
						@*we need to give value as something*@
						<div class="radiobox-behavior">
							<input style="cursor:pointer;" type="radio" name="address" value="@Model.Username" onclick="submitaddress()" />
						</div>

						<div class="make-it-flex-column">
							<label>@Model.Username,</label>
							<label>@Model.AddressLine1,</label>
							<label>@Model.AddressLine2,</label>
							@if (!string.IsNullOrWhiteSpace(Model.NearBy))
							{
								<label>@Model.NearBy,</label>
							}
							<label>@Model.City,</label>
							<label>@Model.State,</label>
							<label>@Model.Pincode .</label>
						</div>
					</form>
					<script>
						function submitaddress() {
						document.getElementById("addressform").submit();
						}
					</script>

					<div class="wrap-add-address">
						<div class="add-address">
							<a href="~/Home/AddAddress">
								+ add Address
							</a>
						</div>
					</div>
					<div class="order-details-checkout">
						<span>Order Details </span>


						<div class="checkout-price-details">
							@{
								int Orderprice = HelperClass.TotalPrice;
								int Tax = Orderprice / 25;
								int DeliveryFee = Orderprice > 100 ? 0 : 54;
								int Total = Orderprice + Tax + DeliveryFee;
							}
							<div class="order-details-fields-only">
								<span>Order Price:  </span>
								<span>Tax: </span>
								<span>Deivery Fee: </span>
								<span>Total: </span>
							</div>
							<div class="order-details-values-only">
								<span>Rs. @Orderprice</span>
								<span>Rs. @Tax</span>
								<span>Rs. @DeliveryFee</span>
								<span>Rs. @Total</span>
							</div>

						</div>
					</div>
					<div class="payment-box-alignment">
						<div class="payment-mode-cart">
							<div class="inside-element-scrollable">
								<div>
									<span class="payment-mode-text">Payment mode</span>
								</div>
								<div class="make-the-paymentmode-middle">

									@* radio button for payment *@

									<form method="post" id="payment" asp-controller="Home" asp-action="Payment">
										<div class="radiobox-address">
											<input style="cursor:pointer;" type="radio" name="paymentmode" value="creditdebit" onchange="submitform()" />
											<span>Credit/Debit Card</span>
										</div>

										<div class="radiobox-address">
											<input style="cursor:pointer;" type="radio" name="paymentmode" value="upiapp" onchange="submitform()" />
											<span>UPI app</span>
										</div>

										<div class="radiobox-address">
											<input style="cursor:pointer;" type="radio" name="paymentmode" value="upiid" onchange="submitform()" />
											<span>UPI ID's</span>
										</div>

										<div class="radiobox-address">
											<input style="cursor:pointer;" type="radio" name="paymentmode" value="cod" onchange="submitform()" />
											<span>Cash on Delivery</span>
										</div>

									</form>

									@*can we enable the payment through radio button functional enable in here ?*@
									@if (HelperClass.IsPaymentCreditCard)
									{
										<div class="payment-through-box">

											<div class="make-it-scrollable">
												<div class="upi-box">
													@* plan to make the respective logo with the text*@
													<img class="upi-app-img-logo" src="~/images/checkout/creditcardlogo.png" alt="creditcard-logo" />
													<span>Credit Card</span>
												</div>

												<div class="upi-box">
													@* plan to make the respective logo with the text*@
													<img class="upi-app-img-logo" src="~/images/checkout/debitcardlogo.png" alt="debitcard-logo" />
													<span>Debit Card</span>
												</div>
											</div>
										</div>

									}
									@if (HelperClass.IsPaymentUpiApp)
									{
										<div class="payment-through-box">
											<div class="make-it-scrollable">

												<div class="upi-box">
													@* plan to make the respective logo with the text*@
													<img class="upi-app-img-logo" src="~/images/checkout/gpaylogo.png" alt="gpay-logo" />
													<span>Google Pay</span>
												</div>

												<div class="upi-box">
													@* plan to make the respective logo with the text*@
													<img class="upi-app-img-logo" src="~/images/checkout/phonepaylogo.png" alt="gpay-logo" />
													<span>Phone Pay</span>
												</div>
												<div class="upi-box">
													@* plan to make the respective logo with the text*@
													<img class="upi-app-img-logo" src="~/images/checkout/paytm.png" alt="gpay-logo" />
													<span>Paytm</span>
												</div>
											</div>
										</div>
									}
									@if (HelperClass.IsPaymentUpiId)
									{
										<form class="payment-through-box" method="post" asp-controller="Home" asp-action="UpiId" id="upiIdform">

											<label>Enter Upi ID</label>
											<input type="text" class="custom-form-control " />
											<button class="custom-submit-btn" type="submit">confirm</button>

										</form>

									}
									@if (HelperClass.IsPaymentCod)
									{
										<div class="payment-through-box">
											<span> Pay Cash during delivery 😀 </span>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
				<div>

					<form class="place-order-btn-align" method="post" asp-controller="Home" asp-action="PlaceOrder">
						<button type="submit" class="place-order-btn">Place Order</button>
					</form>

				</div>
			</div>



		</div>
	</div>
</body>

<script>
	function submitform(){
		document.getElementById("payment").submit();
	}
</script>

<script>
	// Store the scroll position before navigating away
	window.addEventListener("beforeunload", function () {
		sessionStorage.setItem("scrollPosition", window.scrollY);
	});

	// Restore scroll position after page reload
	window.addEventListener("load", function () {
		const scrollY = sessionStorage.getItem("scrollPosition");
		if (scrollY !== null) {
			window.scrollTo(0, parseInt(scrollY));
		}
	});
</script>
