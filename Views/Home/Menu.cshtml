@{
	ViewData["Title"] = "Menu";
}
<head>
	<title>@ViewData["Title"] - CoffeHub</title>
	<link rel="stylesheet" href="~/css/loginpagestyle.css" />
	<link rel="stylesheet" href="~/css/menupagestyle.css" />
</head>
<h1 style="margin-top:10px;">Welcome, @TempData["Username"]. Please Choose your Dish </h1>
<body class="topimage">
	<div class="menuPageLayer1">
		<img src="~/images/coffeeHubsCafe.jpg" />
	</div>
	<h1>Handpicked for you !</h1>
	<div class="menuboxalign">
		<div class="menuLayout">
			<div class="menuItems">
				<div class="imgwithlabel">

					@*latest changed <a> tag *@
					<a class="lookanchor-behavebtn" href="~/Home/BestSeller">
						<img class="imgsize" alt="bestseller" src="~/images/bestseller.jpg" />
						<label class="form-text">BestSeller</label>
					</a>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="breakfast" src="~/images/breakfast.jpg" />
					<label class="form-text">Breakfast</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="meals" src="~/images/meals.jpg" />
					<label class="form-text">Meals</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="chai" src="~/images/chai.png" />
					<label class="form-text">Chai</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="coffee" src="~/images/coffee.jpg" />
					<label class="form-text">Coffee</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="desert" src="~/images/desert.jpg" />
					<label class="form-text">Desert</label>
				</div>
			</div>

			<div class="menuItems">
				<div class="imgwithlabel">
					<img class="imgsize" alt="pizza" src="~/images/pizza.png" />
					<label class="form-text">Pizza</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="snacks" src="~/images/snacks.png" />
					<label class="form-text">Snacks</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="coldbeverage" src="~/images/coldbeverage.png" />
					<label class="form-text">Cold Beverage</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="burger" src="~/images/burger.png" />
					<label class="form-text">Burger</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="pizzacombo" src="~/images/pizzacombo.png" />
					<label class="form-text">Pizza Combo</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="burgercombo" src="~/images/burgercombo.png" />
					<label class="form-text">Burger Combo</label>
				</div>
			</div>
			
			<div class="menuItems">
				<div class="imgwithlabel">
					<img class="imgsize" alt="cake" src="~/images/cake.png" />
					<label class="form-text">Bake and Bliss</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="bread" src="~/images/bread.png" />
					<label class="form-text">Bread Bites</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="chats" src="~/images/chaat.png"/>
					<label class="form-text">Chat</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="eggies" src="~/images/eggies.png"/>
					<label class="form-text">Eggies</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="pasta" src="~/images/pasta.png" />
					<label class="form-text">Pasta</label>
				</div>
				<div class="imgwithlabel">
					<img class="imgsize" alt="maggi" src="~/images/maggi.png" />
					<label class="form-text">maggi</label>
				</div>

			</div>
		
		</div>
	</div>

</body>

